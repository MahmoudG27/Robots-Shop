{
  "uid": "cluster-dashboard",
  "title": "Cluster Overview",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage (Cluster)",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage per Pod",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "sum(container_memory_usage_bytes{container!=\"\"})" }]
    },
    {
      "type": "stat",
      "title": "Running Pods",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "count(kube_pod_status_phase{phase=\"Running\"})" }]
    }
  ]
}