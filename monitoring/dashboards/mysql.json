{
  "uid": "mysql-prod",
  "title": "MySQL Production Dashboard (Exporter)",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",

  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      }
    ]
  },

  "panels": [
    {
      "type": "stat",
      "title": "MySQL Up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mysql_up{job=\"mysql-exporter\"}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Connections %",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{job=\"mysql-exporter\"} / mysql_global_variables_max_connections{job=\"mysql-exporter\"} * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "QPS",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{job=\"mysql-exporter\"}[1m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Threads Running",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mysql_global_status_threads_running{job=\"mysql-exporter\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slow Queries",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries{job=\"mysql-exporter\"}[5m])"
        }
      ]
    }
  ]
}