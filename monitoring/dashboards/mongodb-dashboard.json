{
  "uid": "mongodb-prod",
  "title": "MongoDB Dashboard",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "MongoDB Up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"mongodb-exporter\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Current Connections",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mongodb_connections{state=\"current\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connections Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mongodb_connections{state=\"current\"}",
          "legendFormat": "current"
        },
        {
          "expr": "mongodb_connections{state=\"available\"}",
          "legendFormat": "available"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Document Operations/sec",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mongodb_document_total{type=\"inserted\"}[5m])",
          "legendFormat": "inserted"
        },
        {
          "expr": "rate(mongodb_document_total{type=\"updated\"}[5m])",
          "legendFormat": "updated"
        },
        {
          "expr": "rate(mongodb_document_total{type=\"deleted\"}[5m])",
          "legendFormat": "deleted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Query Operations/sec",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mongodb_operation_total{type=\"query\"}[5m])",
          "legendFormat": "query"
        },
        {
          "expr": "rate(mongodb_operation_total{type=\"command\"}[5m])",
          "legendFormat": "command"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mongodb_memory_resident / 1024 / 1024",
          "legendFormat": "resident"
        },
        {
          "expr": "mongodb_memory_virtual / 1024 / 1024",
          "legendFormat": "virtual"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database Size (MB)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mongodb_database_size_bytes{database!=\"local\", database!=\"admin\"} / 1024 / 1024",
          "legendFormat": "{{database}}"
        }
      ]
    }
  ]
}
