{
  "uid": "mysql-dashboard",
  "title": "MySQL Metrics",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Active Connections",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "mysql_global_status_threads_connected" }]
    },
    {
      "type": "timeseries",
      "title": "QPS",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "rate(mysql_global_status_queries[5m])" }]
    },
    {
      "type": "timeseries",
      "title": "Slow Queries",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "rate(mysql_global_status_slow_queries[5m])" }]
    }
  ]
}