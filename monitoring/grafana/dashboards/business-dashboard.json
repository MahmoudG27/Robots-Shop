{
  "uid": "business-dashboard",
  "title": "Business Metrics",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Total Items Sold",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "sum(sold_count)" }]
    },
    {
      "type": "timeseries",
      "title": "Revenue Rate",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "rate(cart_value_sum[5m])" }]
    },
    {
      "type": "timeseries",
      "title": "Orders per Minute",
      "datasource": { "uid": "prometheus_uid" },
      "targets": [{ "expr": "rate(cart_value_count[5m]) * 60" }]
    }
  ]
}